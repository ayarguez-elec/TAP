<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.SVGPath?>

<ScrollPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.DashboardController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="armoire-scrollpane"
            style="-fx-background-color: #F8FAFC;">

    <HBox spacing="18" style="-fx-background-color: #F8FAFC;">
        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

        <!-- ===== PANNEAU GAUCHE : STATISTIQUES ET GRAPHIQUES (70%) ===== -->
        <VBox spacing="18" HBox.hgrow="ALWAYS">
            
            <!-- Bannière d'accueil premium (Style Mockup) -->
            <HBox styleClass="dashboard-banner" alignment="CENTER_LEFT" spacing="20">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT">
                        <Label fx:id="lblBannerDate" text="📅 --" styleClass="banner-date-pill"/>
                    </HBox>
                    <Label fx:id="lblBannerGreeting" text="Bonjour !" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>
                    <Label fx:id="lblBannerSubtext" text="Passez une excellente journée !" style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.85);"/>
                </VBox>
                <ImageView fitHeight="110" preserveRatio="true">
                    <image>
                        <javafx.scene.image.Image url="@image/icon.png"/>
                    </image>
                </ImageView>
            </HBox>

            <!-- KPI CARDS — GridPane pour 4 colonnes égales -->
            <GridPane hgap="16" vgap="0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25" minWidth="160"/>
                    <ColumnConstraints percentWidth="25" minWidth="160"/>
                    <ColumnConstraints percentWidth="25" minWidth="160"/>
                    <ColumnConstraints percentWidth="25" minWidth="160"/>
                </columnConstraints>

                <!-- KPI 1: Total Pochoirs -->
                <VBox GridPane.columnIndex="0" styleClass="kpi-card" spacing="8">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Total Pochoirs" wrapText="true"
                               style="-fx-font-size: 12px; -fx-font-weight: normal; -fx-text-fill: #64748B;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        
                    </HBox>
                    <Label fx:id="totalPouchoirsLabel" text="0"
                           style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #346771;"/>
                    <Label text="Inventaire global" style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;" wrapText="true"/>
                    <Label fx:id="kpiTotalBadge" text="Parc complet" style="-fx-background-color: #346771; -fx-text-fill: #ffffff; -fx-padding: 4 8; -fx-background-radius: 6; -fx-font-size: 11px; -fx-font-weight: bold;" wrapText="true"/>
                </VBox>

                <!-- KPI 2: Disponibles -->
                <VBox GridPane.columnIndex="1" styleClass="kpi-card" spacing="8">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Disponibles" wrapText="true"
                               style="-fx-font-size: 12px; -fx-font-weight: normal; -fx-text-fill: #64748B;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        
                    </HBox>
                    <Label fx:id="disponiblesLabel" text="0"
                           style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #46BE62;"/>
                    <Label text="En armoire de stockage" style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;" wrapText="true"/>
                    <Label fx:id="kpiDispoBadge" text="-- % du parc" style="-fx-background-color: #46BE62; -fx-text-fill: #ffffff; -fx-padding: 4 8; -fx-background-radius: 6; -fx-font-size: 11px; -fx-font-weight: bold;" wrapText="true"/>
                </VBox>

                <!-- KPI 3: En Production -->
                <VBox GridPane.columnIndex="2" styleClass="kpi-card" spacing="8">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="En Production" wrapText="true"
                               style="-fx-font-size: 12px; -fx-font-weight: normal; -fx-text-fill: #64748B;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        
                    </HBox>
                    <Label fx:id="sortisLabel" text="0"
                           style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #D9691D;"/>
                    <Label text="Actuellement sur ligne" style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;" wrapText="true"/>
                    <Label fx:id="kpiSortiBadge" text="-- % en utilisation" style="-fx-background-color: #D9691D; -fx-text-fill: #ffffff; -fx-padding: 4 8; -fx-background-radius: 6; -fx-font-size: 11px; -fx-font-weight: bold;" wrapText="true"/>
                </VBox>

                <!-- KPI 4: Clients Actifs -->
                <VBox GridPane.columnIndex="3" styleClass="kpi-card" spacing="8">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Clients Actifs" wrapText="true"
                               style="-fx-font-size: 12px; -fx-font-weight: normal; -fx-text-fill: #64748B;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        
                    </HBox>
                    <Label fx:id="clientsLabel" text="0"
                           style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #8E44AD;"/>
                    <Label text="Nomenclature clients" style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;" wrapText="true"/>
                    <Label fx:id="kpiBadgeClients" text="-- produits référencés" style="-fx-background-color: #8E44AD; -fx-text-fill: #ffffff; -fx-padding: 4 8; -fx-background-radius: 6; -fx-font-size: 11px; -fx-font-weight: bold;" wrapText="true"/>
                </VBox>
            </GridPane>

            <!-- LIGNE 1 : Répartition par Racle (Prend toute la largeur de la colonne gauche) -->
            <VBox spacing="0" styleClass="chart-card-teal">
                <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <VBox spacing="2">
                        <Label text="Répartition par Racle"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>
                        <Label text="Pochoirs par taille de racle (mm)"
                               style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.65);"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="📐" style="-fx-font-size: 20px;"/>
                </HBox>

                <BarChart fx:id="racleBarChart" prefHeight="220" legendVisible="false" animated="false"
                          styleClass="bar-chart">
                    <xAxis>
                        <CategoryAxis side="BOTTOM"
                                      style="-fx-tick-label-fill: rgba(255,255,255,0.85); -fx-tick-mark-visible: false;"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis side="LEFT"
                                    style="-fx-tick-label-fill: rgba(255,255,255,0.75); -fx-tick-mark-visible: false; -fx-minor-tick-visible: false;"/>
                    </yAxis>
                </BarChart>

                <HBox spacing="0" alignment="CENTER">
                    <VBox alignment="CENTER" spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="racle300Label" text="0"
                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>
                        <Label text="300 mm"
                               style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.7);"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="racle350Label" text="0"
                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>
                        <Label text="350 mm"
                               style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.7);"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="racle400Label" text="0"
                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>
                        <Label text="400 mm"
                               style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.7);"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="racle460Label" text="0"
                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>
                        <Label text="460 mm"
                               style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.7);"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- LIGNE 2 : Top Clients + Top Programmes (Pie Chart supprimé) -->
            <GridPane hgap="16">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" minWidth="180"/>
                    <ColumnConstraints percentWidth="50" minWidth="180"/>
                </columnConstraints>

                <!-- Top Clients -->
                <VBox GridPane.columnIndex="0" spacing="10"
                      style="-fx-background-color: #ffffff; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #E2E8F0; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.05), 10, 0, 0, 3);">
                    <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <VBox spacing="2">
                            <Label text="Top Clients"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #21262A;"/>
                            <Label text="Classement par nombre de produits"
                                   style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="🏆" style="-fx-font-size: 16px;"/>
                    </HBox>
                    <Separator/>
                    <VBox fx:id="topClientsContainer" spacing="10"/>
                </VBox>

                <!-- Top Programmes -->
                <VBox GridPane.columnIndex="1" spacing="10"
                      style="-fx-background-color: #ffffff; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #E2E8F0; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.05), 10, 0, 0, 3);">
                    <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <VBox spacing="2">
                            <Label text="Top Programmes"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #21262A;"/>
                            <Label text="Pochoirs par programme"
                                   style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="📋" style="-fx-font-size: 16px;"/>
                    </HBox>
                    <Separator/>
                    <VBox fx:id="topProgrammesContainer" spacing="12"/>
                </VBox>
            </GridPane>
        </VBox>

        <!-- ===== PANNEAU DROIT : CALENDRIER, PLANNING & ALERTES (30%) ===== -->
        <VBox spacing="18" prefWidth="260" minWidth="240" maxWidth="260">
            
            <!-- Carte Unique : Calendrier Hebdomadaire & Planning (Style Mockup) -->
            <VBox styleClass="dashboard-card" spacing="0">
                <!-- En-tête de la carte (Teal uni) -->
                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #346771; -fx-background-radius: 14 14 0 0; -fx-padding: 14 16;">
                    <Label text="MON AGENDA" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #ffffff;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="calendarMonthLabel" text="Août" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #ffffff; -fx-padding: 0 10 0 0;"/>
                    <Button text="➕" onAction="#handleAddTask" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: #ffffff; -fx-font-size: 10px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 4 8;"/>
                </HBox>
                
                <!-- Zone corps de la carte -->
                <VBox spacing="14" style="-fx-padding: 16;">
                    <!-- Bandeau horizontal des jours (7 jours de la semaine) -->
                    <HBox fx:id="calendarDayStrip" spacing="2" alignment="CENTER" style="-fx-background-color: #F8FAFC; -fx-padding: 8 6; -fx-background-radius: 12;"/>
                    
                    <!-- Titre du jour sélectionné -->
                    <Label fx:id="selectedDayLabel" text="AOÛT, 12" style="-fx-font-weight: 800; -fx-font-size: 12px; -fx-text-fill: #21262A; -fx-padding: 5 0 2 0;"/>
                    
                    <!-- Container du Planning / Tâches -->
                    <VBox fx:id="planningContainer" spacing="0"/>
                </VBox>
            </VBox>

            <!-- Carte Alertes de Production (Design moderne épuré) -->
            <VBox styleClass="dashboard-card" spacing="12">
                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <SVGPath content="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0zM12 9v4m0 4h.01" styleClass="alert-header-svg"/>
                    <Label text="Alertes de Production" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #E53E3E;"/>
                </HBox>
                <Separator/>
                <VBox fx:id="dashboardAlertsContainer" spacing="8">
                    <!-- Rempli dynamiquement -->
                </VBox>
            </VBox>

            <!-- Actions Rapides Raccourcis -->
            <VBox styleClass="dashboard-card" spacing="12">
                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                <Label text="⚡ Raccourcis rapides" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #21262A;"/>
                <Separator/>
                <Button text="🗄️ Suivi Armoire" styleClass="dashboard-shortcut-btn" onAction="#openSuiviArmoire" maxWidth="Infinity"/>
                <Button text="📝 Codification" styleClass="dashboard-shortcut-btn" onAction="#openCodificationView" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </HBox>
</ScrollPane>
