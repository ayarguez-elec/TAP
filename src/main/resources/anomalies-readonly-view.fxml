<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.AnomaliesReadonlyController"
      spacing="0" style="-fx-background-color: #F8FAFC;">

    <!-- Header -->
    <VBox style="-fx-background-color: #ffffff; -fx-padding: 14 20; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 0, 2);">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="3">
                <Label text="Anomalies Stencils" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #21262A;"/>
                <Label text="Consultation uniquement — signalement réservé à la Production"
                       style="-fx-font-size: 11px; -fx-text-fill: #6F8D94;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <!-- Stats rapides -->
            <HBox spacing="10">
                <VBox alignment="CENTER" style="-fx-background-color: #FEF2F2; -fx-padding: 6 14; -fx-background-radius: 8;">
                    <Label fx:id="kpiCritiques" text="0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #E53E3E;"/>
                    <Label text="Critiques" style="-fx-font-size: 10px; -fx-text-fill: #6F8D94;"/>
                </VBox>
                <VBox alignment="CENTER" style="-fx-background-color: #FFF7ED; -fx-padding: 6 14; -fx-background-radius: 8;">
                    <Label fx:id="kpiMajeurs" text="0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #D9691D;"/>
                    <Label text="Majeurs" style="-fx-font-size: 10px; -fx-text-fill: #6F8D94;"/>
                </VBox>
                <VBox alignment="CENTER" style="-fx-background-color: #F0FFF4; -fx-padding: 6 14; -fx-background-radius: 8;">
                    <Label fx:id="kpiResolus" text="0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #46BE62;"/>
                    <Label text="Résolus" style="-fx-font-size: 10px; -fx-text-fill: #6F8D94;"/>
                </VBox>
            </HBox>
        </HBox>
        <!-- Filtres -->
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 12 0 0 0;">
            <HBox spacing="6" alignment="CENTER_LEFT"
                  style="-fx-background-color: #F8FAFC; -fx-padding: 6 12; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-width: 1; -fx-border-radius: 8;">
                <Label text="🔍" style="-fx-font-size: 12px;"/>
                <TextField fx:id="searchField" promptText="Rechercher stencil, type..."
                           style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 12px; -fx-pref-width: 250;"/>
            </HBox>
            <ComboBox fx:id="filterDegre" promptText="Tous les degrés"
                      style="-fx-font-size: 12px; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E2E8F0;"/>
            <ComboBox fx:id="filterStatut" promptText="Tous les statuts"
                      style="-fx-font-size: 12px; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E2E8F0;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Actualiser" onAction="#refresh"
                    style="-fx-background-color: #346771; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 16; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 12px;"/>
        </HBox>
    </VBox>

    <!-- Table des anomalies -->
    <TableView fx:id="anomaliesTable" VBox.vgrow="ALWAYS"
               style="-fx-background-color: #ffffff; -fx-padding: 16;">
        <columns>
            <TableColumn text="Stencil" fx:id="colStencil" prefWidth="130"/>
            <TableColumn text="Ligne" fx:id="colLigne" prefWidth="80"/>
            <TableColumn text="Type de problème" fx:id="colType" prefWidth="200"/>
            <TableColumn text="Degré" fx:id="colDegre" prefWidth="100"/>
            <TableColumn text="Remarque" fx:id="colRemarque" prefWidth="220"/>
            <TableColumn text="Statut" fx:id="colStatut" prefWidth="90"/>
            <TableColumn text="Date détection" fx:id="colDate" prefWidth="140"/>
        </columns>
    </TableView>
</VBox>