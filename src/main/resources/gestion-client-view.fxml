<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.GestionClientController"
            styleClass="armoire-container"
            prefWidth="Infinity"
            prefHeight="Infinity"
            maxWidth="Infinity"
            maxHeight="Infinity">

    <center>
        <VBox spacing="14" style="-fx-padding: 20 24 20 20; -fx-background-color: #F8FAFC;">
            <!-- Header Section -->
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="suivi-header-card">
                <VBox spacing="2">
                    <Label styleClass="armoire-title" text="%client.title"/>
                    <Label text="Répertoire et fiches détaillées des clients partenaires Lacroix Electronics" style="-fx-text-fill: #6F8D94; -fx-font-size: 12px;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="totalLabel" text="Total: 0 client(s)" styleClass="selected-emp-badge"/>
            </HBox>

            <!-- Barre d'actions et de recherche -->
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="suivi-filter-card">
                <HBox alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS" styleClass="suivi-search-box">
                    <Label text="🔍" style="-fx-font-size: 13px; -fx-opacity: 0.7;"/>
                    <TextField fx:id="searchField" promptText="Rechercher par nom de client, code ou adresse..."
                               HBox.hgrow="ALWAYS" styleClass="suivi-search-input"/>
                </HBox>

                <Button text="➕ Nouveau Client" onAction="#handleAdd" styleClass="btn-primary"/>
                <Button text="🔄 Réinitialiser" onAction="#handleRefresh" styleClass="btn-reset-modern"/>
            </HBox>

            <!-- Grille des cartes clients -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="armoire-scrollpane">
                <TilePane fx:id="cardContainer"
                          prefColumns="4"
                          alignment="TOP_LEFT"
                          hgap="14" vgap="14">
                    <padding>
                        <Insets top="4" right="4" bottom="4" left="4"/>
                    </padding>
                </TilePane>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>