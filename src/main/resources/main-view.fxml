<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.MainController"
            stylesheets="@css/style.css">

    <top>
        <HBox styleClass="header-modern" alignment="CENTER_LEFT" spacing="15">

            <!-- Logo -->
            <HBox spacing="10" alignment="CENTER">
                <ImageView fx:id="logoImage" fitHeight="35" fitWidth="35" preserveRatio="true">
                    <image>
                        <Image url="@image/logo.png" backgroundLoading="true"/>
                    </image>
                </ImageView>
                <VBox alignment="CENTER_LEFT">
                    <Label text="Lacroix" styleClass="logo-text-modern"/>
                    <Label text="Process" styleClass="logo-subtitle-modern"/>
                </VBox>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>
            
            <HBox alignment="CENTER" spacing="10">
                <!-- Theme Toggle -->
                <Button fx:id="btnThemeToggle" onAction="#toggleTheme"
                        style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 6;">
                    <graphic>
                        <Label fx:id="themeIconLabel" text="🌙" style="-fx-font-size: 20px; -fx-text-fill: #ffffff;"/>
                    </graphic>
                </Button>
                <!-- Language Toggle -->
                <ComboBox fx:id="comboLanguage" onAction="#changeLanguage" 
                          styleClass="suivi-combo" style="-fx-pref-width: 80;"/>
            </HBox>

            <!-- Bouton Notification avec Badge Rouge Facebook-style -->
            <StackPane alignment="TOP_RIGHT">
                <Button fx:id="btnNotifications" onAction="#showNotifications"
                        style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 6 10 6 10;">
                    <graphic>
                        <Label text="🔔" style="-fx-font-size: 22px; -fx-text-fill: #ffffff;"/>
                    </graphic>
                </Button>
                <!-- Badge Rouge Facebook -->
                <StackPane fx:id="notificationBadgeContainer" visible="false" mouseTransparent="true"
                           style="-fx-background-color: #E53E3E; -fx-background-radius: 10; -fx-min-width: 18px; -fx-min-height: 18px; -fx-padding: 1 5 1 5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 4, 0, 0, 1);">
                    <StackPane.margin>
                        <Insets top="0" right="4" bottom="0" left="0"/>
                    </StackPane.margin>
                    <Label fx:id="notificationBadge" text="0" style="-fx-text-fill: #ffffff; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                </StackPane>
            </StackPane>

        </HBox>
    </top>

    <left>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: #ffffff; -fx-background: #ffffff; -fx-border-color: transparent; -fx-pref-width: 235; -fx-min-width: 235; -fx-max-width: 235;"
                    prefWidth="235" minWidth="235" maxWidth="235">
        <VBox styleClass="sidebar-category" spacing="0" minHeight="600">

            <!-- ===== CATÉGORIE : PRINCIPAL ===== -->
            <Label styleClass="category-label" text="%nav.main"/>

            <Button styleClass="menu-button-category" fx:id="btnBoard" onAction="#showBoard" text="%nav.dashboard">
                <graphic>
                    <SVGPath content="M3 3h7v7H3zm11 0h7v7h-7zM3 14h7v7H3zm11 0h7v7h-7z" styleClass="sidebar-icon-path"/>
                </graphic>
            </Button>

            <Button styleClass="menu-button-category" fx:id="btnSuivi" onAction="#showSuivi" text="%nav.suivi">
                <graphic>
                    <SVGPath content="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8zm0 11a3 3 0 1 1 3-3 3 3 0 0 1-3 3z" styleClass="sidebar-icon-path"/>
                </graphic>
            </Button>

            <Button styleClass="menu-button-category" fx:id="btnHistorique" onAction="#showHistorique" text="%nav.historique">
                <graphic>
                    <SVGPath content="M12 8v4l3 3m6-3a9 9 0 1 1-18 0 9 9 0 0 1 18 0z" styleClass="sidebar-icon-path"/>
                </graphic>
            </Button>

            <Button styleClass="menu-button-category" fx:id="btnPlanning" onAction="#showPlanning" text="%nav.planning">
                <graphic>
                    <SVGPath content="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2z" styleClass="sidebar-icon-path"/>
                </graphic>
            </Button>

            <Button styleClass="menu-button-category" fx:id="btnAnomalies" onAction="#showAnomalies" text="%nav.anomalies">
                <graphic>
                    <SVGPath content="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" styleClass="sidebar-icon-path"/>
                </graphic>
            </Button>

            <!-- ===== CATÉGORIE : GESTION ===== -->
            <Label styleClass="category-label" text="%nav.gestion" style="-fx-padding: 15 0 8 20;"/>

            <Button styleClass="menu-button-category" fx:id="btnGestionClients" onAction="#showGestionClients" text="%nav.clients">
                <graphic>
                    <SVGPath content="M20 7h-4V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v3H4a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2zM9 7V4h6v3" styleClass="sidebar-icon-path"/>
                </graphic>
            </Button>

            <Button styleClass="menu-button-category" fx:id="btnGestionPouchoirs" onAction="#showGestionPouchoirs" text="%nav.pochoirs">
                <graphic>
                    <SVGPath content="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" styleClass="sidebar-icon-path"/>
                </graphic>
            </Button>

            <Button styleClass="menu-button-category" fx:id="btnRapports" onAction="#showRapports" text="%nav.fiches">
                <graphic>
                    <SVGPath content="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2" styleClass="sidebar-icon-path"/>
                </graphic>
            </Button>
            
            <!-- ===== CATÉGORIE : ADMINISTRATION ===== -->
            <Label styleClass="category-label" text="%nav.admin" style="-fx-padding: 15 0 8 20;"/>

            <Button styleClass="menu-button-category" fx:id="btnGestionUsers" onAction="#showGestionUtilisateurs" text="%nav.utilisateurs">
                <graphic>
                    <SVGPath content="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 7a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm14 14v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" styleClass="sidebar-icon-path"/>
                </graphic>
            </Button>

            <Button styleClass="menu-button-category" fx:id="btnPermissions" onAction="#showPermissions" text="%nav.permissions">
                <graphic>
                    <SVGPath content="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" styleClass="sidebar-icon-path"/>
                </graphic>
            </Button>
            
            <Region VBox.vgrow="ALWAYS"/>

            <!-- ===== FOOTER SIDEBAR PRO : PROFIL & DÉCONNEXION ===== -->
            <VBox styleClass="sidebar-user-footer" spacing="10">
                <!-- Profil Utilisateur Carte -->
                <HBox spacing="10" alignment="CENTER_LEFT" styleClass="sidebar-user-card">
                    <StackPane>
                        <Circle radius="18" fill="#346771"/>
                        <Label fx:id="userInitialsLabel" text="U" style="-fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="1" HBox.hgrow="ALWAYS">
                        <Label fx:id="userNameLabel" text="Utilisateur" style="-fx-text-fill: #21262A; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                        <Label fx:id="userRoleLabel" text="%nav.role.operator" style="-fx-text-fill: #6F8D94; -fx-font-size: 11px;"/>
                    </VBox>
                </HBox>

                <!-- Bouton Déconnexion Pro -->
                <Button fx:id="btnDeconnexion" text="%nav.logout" styleClass="sidebar-logout-btn" onAction="#handleLogout"/>

                <Label text="v1.0 | Lacroix Electronics" style="-fx-text-fill: #A0AEC0; -fx-font-size: 10px; -fx-alignment: CENTER;" alignment="CENTER" maxWidth="Infinity"/>
            </VBox>
        </VBox>
        </ScrollPane>
    </left>

    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">
            <VBox alignment="CENTER" spacing="25">
                <Label text="Lacroix Electronics" style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #21262A;"/>
                <Label text="%header.select_option" style="-fx-font-size: 14px; -fx-text-fill: #A8B2C1;"/>

                <HBox spacing="20" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                    <VBox styleClass="stats-card">
                        <Label styleClass="stats-number, stats-teal" text="0" fx:id="totalPouchoirs"/>
                        <Label styleClass="stats-label" text="%stat.total_pochoirs"/>
                    </VBox>
                    <VBox styleClass="stats-card">
                        <Label styleClass="stats-number, stats-green" text="0" fx:id="disponibles"/>
                        <Label styleClass="stats-label" text="%stat.available"/>
                    </VBox>
                    <VBox styleClass="stats-card">
                        <Label styleClass="stats-number, stats-orange" text="0" fx:id="sortis"/>
                        <Label styleClass="stats-label" text="%stat.out"/>
                    </VBox>
                    <VBox styleClass="stats-card">
                        <Label styleClass="stats-number, stats-teal-light" text="0" fx:id="totalProduits"/>
                        <Label styleClass="stats-label" text="%stat.total_products"/>
                    </VBox>
                </HBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>