                                      -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                      -fx-background-color: #fafbfc;"
                               GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="300"/>

                    <Label text="D&#233;signation Cr&#232;me" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="designationCremeField" promptText="D&#233;signation de la cr&#232;me"
                               style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                      -fx-background-color: #fafbfc;"
                               GridPane.rowIndex="4" GridPane.columnIndex="1" prefWidth="300"/>

                    <Label text="R&#233;f. Lacroix" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <TextField fx:id="refLacroixField" promptText="R&#233;f&#233;rence Lacroix"
                               style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                      -fx-background-color: #fafbfc;"
                               GridPane.rowIndex="5" GridPane.columnIndex="1" prefWidth="300"/>

                    <Label text="Code-barres" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <TextField fx:id="codeBarreField" promptText="Code-barres"
                               style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                      -fx-background-color: #fafbfc;"
                               GridPane.rowIndex="6" GridPane.columnIndex="1" prefWidth="300"/>
                </GridPane>
            </VBox>

            <!-- ====== SECTION 3 : Passage A ====== -->
            <VBox spacing="10" style="-fx-background-color: #ffffff;
                                      -fx-border-radius: 10;
                                      -fx-background-radius: 10;
                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);
                                      -fx-padding: 18 25 18 25;"
                  maxWidth="720" prefWidth="720">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Rectangle width="3" height="18" fill="#3A98A5" arcWidth="2" arcHeight="2"/>
                    <Label text="Passage A"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #21262A;"/>
                </HBox>
                <Separator style="-fx-background-color: #e8eaee;"/>
                <GridPane hgap="15" vgap="10" style="-fx-padding: 5 0 5 0;">
                    <Label text="Date" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="aDateField" promptText="JJ/MM/AAAA"
                               style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                      -fx-background-color: #fafbfc;"
                               GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300"/>

                    <Label text="Machine" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="aMachineField" promptText="Nom de la machine"
                               style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                      -fx-background-color: #fafbfc;"
                               GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="300"/>

                    <Label text="Pression Avant" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="aPressionAvField" promptText="kg"
                               style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                      -fx-background-color: #fafbfc;"
                               GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="300"/>

                    <Label text="Pression Arri&#232;re" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="aPressionArField" promptText="kg"
                               style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                      -fx-background-color: #fafbfc;"
                               GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="300"/>

                    <Label text="Support" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="aSupportField" promptText="Type de support"
                               style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                      -fx-background-color: #fafbfc;"
                               GridPane.rowIndex="4" GridPane.columnIndex="1" prefWidth="300"/>

                    <Label text="Nombre" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <TextField fx:id="aNombreField" promptText="Quantit&#233;"
                               style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                      -fx-background-color: #fafbfc;"
                               GridPane.rowIndex="5" GridPane.columnIndex="1" prefWidth="300"/>

                    <Label text="Racle mm" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <TextField fx:id="aRacleField" promptText="mm"
                               style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                      -fx-background-color: #fafbfc;"
                               GridPane.rowIndex="6" GridPane.columnIndex="1" prefWidth="300"/>

                    <Label text="Info Techniques" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                    <TextArea fx:id="aInfoField" promptText="Informations techniques sp&#233;cifiques"
                              prefRowCount="2"
                              style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                     -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                     -fx-background-color: #fafbfc;"
                              GridPane.rowIndex="7" GridPane.columnIndex="1" prefWidth="300"/>

                    <Label text="Visa" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                    <TextField fx:id="aVisaField" promptText="Visa"
                               style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                      -fx-background-color: #fafbfc;"
                               GridPane.rowIndex="8" GridPane.columnIndex="1" prefWidth="300"/>
                </GridPane>
            </VBox>

            <!-- ====== SECTION 4 : Passage B ====== -->
            <VBox spacing="10" style="-fx-background-color: #ffffff;
                                      -fx-border-radius: 10;
                                      -fx-background-radius: 10;
                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);
                                      -fx-padding: 18 25 18 25;"
                  maxWidth="720" prefWidth="720">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Rectangle width="3" height="18" fill="#3A98A5" arcWidth="2" arcHeight="2"/>
                    <Label text="Passage B"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #21262A;"/>
                </HBox>
                <Separator style="-fx-background-color: #e8eaee;"/>
                <GridPane hgap="15" vgap="10" style="-fx-padding: 5 0 5 0;">
                    <Label text="Date" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="bDateField" promptText="JJ/MM/AAAA"
                               style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                      -fx-background-color: #fafbfc;"
                               GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300"/>

                    <Label text="Machine" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="bMachineField" promptText="Nom de la machine"
                               style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                      -fx-background-color: #fafbfc;"
                               GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="300"/>

                    <Label text="Pression Avant" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="bPressionAvField" promptText="kg"
                               style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                      -fx-background-color: #fafbfc;"
                               GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="300"/>

                    <Label text="Pression Arri&#232;re" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="bPressionArField" promptText="kg"
                               style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                      -fx-background-color: #fafbfc;"
                               GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="300"/>

                    <Label text="Support" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="bSupportField" promptText="Type de support"
                               style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                      -fx-background-color: #fafbfc;"
                               GridPane.rowIndex="4" GridPane.columnIndex="1" prefWidth="300"/>

                    <Label text="Nombre" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <TextField fx:id="bNombreField" promptText="Quantit&#233;"
                               style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                      -fx-background-color: #fafbfc;"
                               GridPane.rowIndex="5" GridPane.columnIndex="1" prefWidth="300"/>

                    <Label text="Racle mm" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <TextField fx:id="bRacleField" promptText="mm"
                               style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                      -fx-background-color: #fafbfc;"
                               GridPane.rowIndex="6" GridPane.columnIndex="1" prefWidth="300"/>

                    <Label text="Info Techniques" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                    <TextArea fx:id="bInfoField" promptText="Informations techniques sp&#233;cifiques"
                              prefRowCount="2"
                              style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                     -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                     -fx-background-color: #fafbfc;"
                              GridPane.rowIndex="7" GridPane.columnIndex="1" prefWidth="300"/>

                    <Label text="Nature &#201;volution" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                    <TextArea fx:id="bNatureField" promptText="Nature de l'&#233;volution"
                              prefRowCount="2"
                              style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                     -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                     -fx-background-color: #fafbfc;"
                              GridPane.rowIndex="8" GridPane.columnIndex="1" prefWidth="300"/>

                    <Label text="Visa" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="9" GridPane.columnIndex="0"/>
                    <TextField fx:id="bVisaField" promptText="Visa"
                               style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
