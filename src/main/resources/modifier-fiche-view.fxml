<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.ModifierFicheController"
      spacing="0"
      alignment="TOP_CENTER"
      style="-fx-background-color: #f0f2f5;"
      prefWidth="Infinity"
      prefHeight="Infinity">

    <!-- HEADER -->
    <VBox style="-fx-background-color: #ffffff;
                 -fx-padding: 12 25;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 2); -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Button text="&#8592; Retour" onAction="#handleRetour"
                    style="-fx-background-color: #EBF8F9; -fx-text-fill: #346771; -fx-font-weight: bold; -fx-padding: 5 14; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-size: 12px; -fx-border-color: #346771; -fx-border-width: 1;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER_RIGHT">
                <Label text="Modifier la Fiche S&#233;rigraphie"
                       style="-fx-text-fill: #21262A; -fx-font-size: 17px; -fx-font-weight: bold; -fx-letter-spacing: 1px;"/>
                <Label text="Modifier les informations de la fiche"
                       style="-fx-text-fill: #6F8D94; -fx-font-size: 10px; -fx-font-weight: 300;"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- SCROLL PANE -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;"
                VBox.vgrow="ALWAYS">

        <VBox spacing="14" alignment="TOP_CENTER" style="-fx-padding: 20 30 10 30; -fx-background-color: #f0f2f5;">

            <!-- ====== SECTION 1 : Informations Generales ====== -->
            <VBox spacing="10" style="-fx-background-color: #ffffff;
                                      -fx-border-radius: 10;
                                      -fx-background-radius: 10;
                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);
                                      -fx-padding: 18 25 18 25;"
                  maxWidth="720" prefWidth="720">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Rectangle width="3" height="18" fill="#3A98A5" arcWidth="2" arcHeight="2"/>
                    <Label text="Informations G&#233;n&#233;rales"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #21262A;"/>
                </HBox>
                <Separator style="-fx-background-color: #e8eaee;"/>
                <GridPane hgap="15" vgap="10" style="-fx-padding: 5 0 5 0;">
                    <Label text="Client" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="clientField" promptText="Nom du client"
                               style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                      -fx-background-color: #fafbfc;"
                               GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300"/>

                    <Label text="Produit" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="produitField" promptText="R&#233;f&#233;rence produit"
                               style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                      -fx-background-color: #fafbfc;"
                               GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="300"/>

                    <Label text="Face" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="faceField" promptText="Ex: 1, 2, TOP, BOT"
                               style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                      -fx-background-color: #fafbfc;"
                               GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="300"/>

                    <Label text="N&#176; Programme" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="programmeField" promptText="Num&#233;ro de programme"
                               style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                      -fx-background-color: #fafbfc;"
                               GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="300"/>

                    <Label text="N&#176; PCB" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="pcbField" promptText="Num&#233;ro PCB"
                               style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                      -fx-background-color: #fafbfc;"
                               GridPane.rowIndex="4" GridPane.columnIndex="1" prefWidth="300"/>
                </GridPane>
            </VBox>

            <!-- ====== SECTION 2 : Ecran & Creme ====== -->
            <VBox spacing="10" style="-fx-background-color: #ffffff;
                                      -fx-border-radius: 10;
                                      -fx-background-radius: 10;
                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);
                                      -fx-padding: 18 25 18 25;"
                  maxWidth="720" prefWidth="720">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Rectangle width="3" height="18" fill="#3A98A5" arcWidth="2" arcHeight="2"/>
                    <Label text="&#201;cran &amp; Cr&#232;me"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #21262A;"/>
                </HBox>
                <Separator style="-fx-background-color: #e8eaee;"/>
                <GridPane hgap="15" vgap="10" style="-fx-padding: 5 0 5 0;">
                    <Label text="Mati&#232;re &#201;cran" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="matiereEcranField" promptText="Mati&#232;re de l'&#233;cran"
                               style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                      -fx-background-color: #fafbfc;"
                               GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300"/>

                    <Label text="N&#176; &#201;cran" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="numeroEcranField" promptText="Num&#233;ro d'&#233;cran"
                               style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                      -fx-background-color: #fafbfc;"
                               GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="300"/>

                    <Label text="&#201;paisseur" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="epaisseurField" promptText="Ex: 150&#956;m"
                               style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                      -fx-background-color: #fafbfc;"
                               GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="300"/>

                    <Label text="Fournisseur Cr&#232;me" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                           GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="fournisseurCremeField" promptText="Nom du fournisseur"
