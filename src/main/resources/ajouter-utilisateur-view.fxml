<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.AjouterUtilisateurController"
      spacing="0"
      alignment="TOP_CENTER"
      style="-fx-background-color: #f0f2f5;"
      prefWidth="Infinity"
      prefHeight="Infinity">

    <!-- HEADER -->
    <VBox style="-fx-background-color: #ffffff;
                 -fx-padding: 12 25;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 2); -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">

        <HBox alignment="CENTER_LEFT" spacing="15">
            <Button text="&#8592; Retour" onAction="#handleRetour"
                    style="-fx-background-color: #EBF8F9; -fx-text-fill: #346771; -fx-font-weight: bold; -fx-padding: 5 14; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-size: 12px; -fx-border-color: #346771; -fx-border-width: 1;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox alignment="CENTER_RIGHT">
                <Label text="Nouvel Utilisateur"
                       style="-fx-text-fill: #21262A; -fx-font-size: 17px; -fx-font-weight: bold; -fx-letter-spacing: 1px;"/>
                <Label text="Cr&#233;er un nouveau compte utilisateur"
                       style="-fx-text-fill: #6F8D94; -fx-font-size: 10px; -fx-font-weight: 300;"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- CORPS -->
    <VBox spacing="12" alignment="TOP_CENTER" style="-fx-padding: 20 30; -fx-background-color: #f0f2f5;">

        <!-- Carte formulaire -->
        <VBox spacing="12" style="-fx-background-color: #ffffff;
                                  -fx-border-radius: 10;
                                  -fx-background-radius: 10;
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);
                                  -fx-padding: 18 25 18 25;"
              maxWidth="650" prefWidth="650">

            <HBox alignment="CENTER_LEFT" spacing="8">
                <Rectangle width="3" height="18" fill="#3A98A5" arcWidth="2" arcHeight="2"/>
                <Label text="Informations du compte"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #21262A;"/>
            </HBox>

            <Separator style="-fx-background-color: #e8eaee;"/>

            <GridPane hgap="15" vgap="10" alignment="CENTER" style="-fx-padding: 5 0 5 0;">

                <!-- Ligne 0 : Nom complet -->
                <Label text="Nom complet" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                       GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="nomField" promptText="Nom complet de l'utilisateur"
                           style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                  -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                  -fx-background-color: #fafbfc;"
                           GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300"/>

                <!-- Ligne 1 : Username -->
                <Label text="Username" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                       GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="usernameField" promptText="Identifiant de connexion"
                           style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                  -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                  -fx-background-color: #fafbfc;"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <!-- Ligne 2 : Mot de passe -->
                <Label text="Mot de passe" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                       GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <PasswordField fx:id="passwordField" promptText="Minimum 8 caract&#232;res"
                               style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                      -fx-background-color: #fafbfc;"
                               GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <!-- Ligne 3 : Confirmer mot de passe -->
                <Label text="Confirmer mot de passe" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                       GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <PasswordField fx:id="confirmPasswordField" promptText="R&#233;p&#233;ter le mot de passe"
                               style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                      -fx-background-color: #fafbfc;"
                               GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <!-- Ligne 4 : Rôle -->
                <Label text="R&#244;le" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                       GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <ComboBox fx:id="roleCombo" prefWidth="300"
                          style="-fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-border-radius: 6;
                                 -fx-background-radius: 6; -fx-background-color: #fafbfc; -fx-font-size: 12px;"
                          GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <!-- Ligne 5 : Actif -->
                <Label text="Actif" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                       GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <CheckBox fx:id="actifCheck" text="Compte actif"
                          style="-fx-font-size: 12px; -fx-text-fill: #21262A;"
                          GridPane.rowIndex="5" GridPane.columnIndex="1"/>

            </GridPane>

            <HBox spacing="12" alignment="CENTER" style="-fx-padding: 8 0 0 0;">
                <Button text="Annuler" onAction="#handleAnnuler"
                        style="-fx-background-color: #e8eaee;
                               -fx-text-fill: #6F8D94;
                               -fx-font-weight: bold;
                               -fx-padding: 6 25;
                               -fx-border-radius: 6;
                               -fx-background-radius: 6;
                               -fx-cursor: hand;
                               -fx-font-size: 12px;"/>
                <Button text="&#9989; Enregistrer" onAction="#handleEnregistrer"
                        style="-fx-background-color: #46BE62;
                               -fx-text-fill: #ffffff;
                               -fx-font-weight: bold;
                               -fx-padding: 6 25;
                               -fx-border-radius: 6;
                               -fx-background-radius: 6;
                               -fx-cursor: hand;
                               -fx-font-size: 12px;
                               -fx-effect: dropshadow(gaussian, rgba(70,190,98,0.3), 6, 0, 0, 2);"/>
            </HBox>

        </VBox>

    </VBox>
</VBox>
