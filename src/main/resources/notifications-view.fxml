<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.NotificationsController"
            prefWidth="Infinity"
            prefHeight="Infinity"
            maxWidth="Infinity"
            maxHeight="Infinity"
            style="-fx-background-color: #f0f2f5;">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Button text="← Retour" onAction="#handleRetour"
                    style="-fx-background-color: #6F8D94; -fx-text-fill: #ffffff; -fx-font-weight: bold;
                           -fx-padding: 6 16; -fx-border-radius: 6; -fx-background-radius: 6;
                           -fx-cursor: hand; -fx-font-size: 12px;"/>
            <Label text="🔔 Notifications" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #21262A;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Tout marquer comme lu" onAction="#handleMarkAllRead"
                    style="-fx-background-color: #46BE62; -fx-text-fill: #ffffff; -fx-font-weight: bold;
                           -fx-padding: 8 20; -fx-border-radius: 15; -fx-background-radius: 15;
                           -fx-cursor: hand; -fx-font-size: 12px;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="15" prefWidth="Infinity" prefHeight="Infinity" style="-fx-padding: 10 0 0 0;">

            <!-- Statistiques des alertes -->
            <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 10 15; -fx-background-color: #ffffff;
                                                              -fx-border-radius: 8; -fx-background-radius: 8;
                                                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 0, 2);">
                <Label text="📊" style="-fx-font-size: 16px;"/>
                <Label fx:id="totalAlertes" text="Total: 0" style="-fx-text-fill: #21262A; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                <Label fx:id="nonLues" text="🔴 Non lues: 0" style="-fx-text-fill: #D9691D; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                <Label fx:id="lues" text="🟢 Lues: 0" style="-fx-text-fill: #46BE62; -fx-font-weight: bold; -fx-font-size: 14px;"/>
            </HBox>

            <Separator style="-fx-background-color: #e8eaee;"/>

            <!-- Liste des alertes -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-padding: 0; -fx-border-color: transparent;">
                <VBox fx:id="alertesContainer" spacing="10" style="-fx-padding: 5 0 10 0;"/>
            </ScrollPane>

        </VBox>
    </center>
</BorderPane>