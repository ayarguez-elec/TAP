<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.DetailsClientController"
            styleClass="gestion-container"
            prefWidth="Infinity"
            prefHeight="Infinity"
            maxWidth="Infinity"
            maxHeight="Infinity">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Button text="← Retour" onAction="#handleRetour"
                    style="-fx-background-color: #6F8D94; -fx-text-fill: #ffffff; -fx-font-weight: bold;
                           -fx-padding: 4 12; -fx-border-radius: 6; -fx-background-radius: 6;
                           -fx-cursor: hand; -fx-font-size: 11px;"/>
            <Label fx:id="clientNomLabel" text="👤 Détails du Client" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #21262A;"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="15" prefWidth="Infinity" prefHeight="Infinity">

            <!-- Informations du client -->
            <VBox spacing="10" style="-fx-background-color: #ffffff;
                                      -fx-border-radius: 10;
                                      -fx-background-radius: 10;
                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);
                                      -fx-padding: 15 20;"
                  maxWidth="Infinity">

                <HBox spacing="15" alignment="CENTER_LEFT">
                    <StackPane fx:id="logoContainer" prefWidth="50" prefHeight="50">
                        <Label text="👤" style="-fx-font-size: 32px;"/>
                    </StackPane>

                    <VBox spacing="2">
                        <Label fx:id="nomValue" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #21262A;"/>
                        <Label fx:id="codeValue" style="-fx-text-fill: #6F8D94; -fx-font-size: 12px;"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <VBox spacing="2" alignment="CENTER_RIGHT">
                        <Label fx:id="telephoneValue" style="-fx-text-fill: #384B52; -fx-font-size: 13px;"/>
                        <Label fx:id="emailValue" style="-fx-text-fill: #384B52; -fx-font-size: 13px;"/>
                    </VBox>
                </HBox>

                <HBox spacing="15">
                    <Label fx:id="adresseValue" style="-fx-text-fill: #666; -fx-font-size: 12px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="dateValue" style="-fx-text-fill: #999; -fx-font-size: 11px;"/>
                </HBox>

                <Separator style="-fx-background-color: #e8eaee;"/>

                <!-- ✅ Barre de recherche par produit -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="searchProduitField" promptText="🔍 Rechercher un produit..."
                               HBox.hgrow="ALWAYS"
                               style="-fx-padding: 6 12; -fx-border-radius: 20; -fx-background-radius: 20;
                                      -fx-border-color: #d0d5dd; -fx-background-color: #ffffff;"/>
                    <Button text="🔄" onAction="#handleRefreshProduits"
                            style="-fx-background-color: #6F8D94; -fx-text-fill: #ffffff; -fx-font-weight: bold;
                                   -fx-padding: 6 12; -fx-border-radius: 20; -fx-background-radius: 20;
                                   -fx-cursor: hand; -fx-font-size: 13px;"/>
                </HBox>

                <!-- En-tête produits -->
                <HBox spacing="20">
                    <Label text="Produits :" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 14px;"/>
                    <Label fx:id="produitsCount" style="-fx-text-fill: #3A98A5; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="➕ Ajouter produit" onAction="#handleAddProduit"
                            style="-fx-background-color: #46BE62; -fx-text-fill: #ffffff; -fx-font-weight: bold;
                                   -fx-padding: 6 16; -fx-border-radius: 15; -fx-background-radius: 15;
                                   -fx-cursor: hand; -fx-font-size: 12px;"/>
                </HBox>
            </VBox>

            <!-- Liste des produits du client -->
            <TableView fx:id="produitsTable" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: #ffffff; -fx-border-color: #E2E8F0;
                              -fx-border-radius: 10; -fx-background-radius: 10;">
                <columns>
                    <TableColumn fx:id="colNom" text="Nom Produit" prefWidth="220"/>
                    <TableColumn fx:id="colCode" text="Code" prefWidth="120"/>
                    <TableColumn fx:id="colEcran" text="Écran" prefWidth="120"/>
                    <TableColumn fx:id="colPochoirs" text="Pochoirs" prefWidth="80"/>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="100"/>
                    <TableColumn fx:id="colActions" text="Actions" prefWidth="200"/>
                </columns>
                <placeholder>
                    <VBox alignment="CENTER" spacing="12">
                        <Label text="📭" style="-fx-font-size: 40px;"/>
                        <Label text="Aucun produit pour ce client"/>
                    </VBox>
                </placeholder>
            </TableView>

        </VBox>
    </center>
</BorderPane>