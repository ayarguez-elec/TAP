<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.AjouterClientController"
      spacing="0"
      alignment="TOP_CENTER"
      style="-fx-background-color: #f0f2f5;"
      prefWidth="Infinity"
      prefHeight="Infinity">

    <!-- HEADER -->
    <VBox style="-fx-background-color: #ffffff;
                 -fx-padding: 12 25;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 2); -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">

        <HBox alignment="CENTER_LEFT" spacing="15">
            <Button text="← Retour" onAction="#handleRetour"
                    style="-fx-background-color: #EBF8F9; -fx-text-fill: #346771; -fx-font-weight: bold; -fx-padding: 5 14; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-size: 12px; -fx-border-color: #346771; -fx-border-width: 1;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox alignment="CENTER_RIGHT">
                <Label text="Nouveau Client"
                       style="-fx-text-fill: #21262A; -fx-font-size: 17px; -fx-font-weight: bold; -fx-letter-spacing: 1px;"/>
                <Label text="Remplissez les informations ci-dessous"
                       style="-fx-text-fill: #6F8D94; -fx-font-size: 10px; -fx-font-weight: 300;"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- CORPS -->
    <VBox spacing="12" alignment="TOP_CENTER" style="-fx-padding: 20 30; -fx-background-color: #f0f2f5;">

        <!-- Carte formulaire -->
        <VBox spacing="12" style="-fx-background-color: #ffffff;
                                  -fx-border-radius: 10;
                                  -fx-background-radius: 10;
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);
                                  -fx-padding: 18 25 18 25;"
              maxWidth="650" prefWidth="650">

            <HBox alignment="CENTER_LEFT" spacing="8">
                <Rectangle width="3" height="18" fill="#3A98A5" arcWidth="2" arcHeight="2"/>
                <Label text="Informations du client"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #21262A;"/>
            </HBox>

            <Separator style="-fx-background-color: #e8eaee;"/>

            <GridPane hgap="15" vgap="10" alignment="CENTER" style="-fx-padding: 5 0 5 0;">

                <!-- ✅ Ligne 0 : Logo / Image -->
                <Label text="Logo :" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                       GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="0" GridPane.columnIndex="1">
                    <ImageView fx:id="logoPreview" fitHeight="50" fitWidth="50"
                               style="-fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                    <Button text="Choisir une image" onAction="#handleChooseImage"
                            style="-fx-background-color: #346771; -fx-text-fill: #ffffff; -fx-font-weight: bold;
                                   -fx-padding: 6 15; -fx-border-radius: 6; -fx-background-radius: 6;
                                   -fx-cursor: hand; -fx-font-size: 12px;"/>
                </HBox>

                <!-- Ligne 1 : Nom -->
                <Label text="Nom" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                       GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="nomField" promptText="Nom du client"
                           style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                  -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                  -fx-background-color: #fafbfc;"
                           GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="300"/>

                <!-- Ligne 2 : Code -->
                <Label text="Code" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                       GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="codeField" promptText="Code client"
                           style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                  -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                  -fx-background-color: #fafbfc;"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <!-- Ligne 3 : Téléphone -->
                <Label text="Téléphone" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                       GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="telephoneField" promptText="Ex: 0123456789"
                           style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                  -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                  -fx-background-color: #fafbfc;"
                           GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <!-- Ligne 4 : Email -->
                <Label text="Email" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                       GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="emailField" promptText="Ex: client@email.com"
                           style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                  -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                  -fx-background-color: #fafbfc;"
                           GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <!-- Ligne 5 : Adresse -->
                <Label text="Adresse" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 12px;"
                       GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <TextField fx:id="adresseField" promptText="Adresse du client"
                           style="-fx-padding: 6 10; -fx-border-radius: 6; -fx-background-radius: 6;
                                  -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                  -fx-background-color: #fafbfc;"
                           GridPane.rowIndex="5" GridPane.columnIndex="1"/>

            </GridPane>

            <HBox spacing="12" alignment="CENTER" style="-fx-padding: 8 0 0 0;">
                <Button text="Annuler" onAction="#handleAnnuler"
                        style="-fx-background-color: #e8eaee;
                               -fx-text-fill: #6F8D94;
                               -fx-font-weight: bold;
                               -fx-padding: 6 25;
                               -fx-border-radius: 6;
                               -fx-background-radius: 6;
                               -fx-cursor: hand;
                               -fx-font-size: 12px;"/>
                <Button text="✅ Valider" onAction="#handleValider"
                        style="-fx-background-color: #46BE62;
                               -fx-text-fill: #ffffff;
                               -fx-font-weight: bold;
                               -fx-padding: 6 25;
                               -fx-border-radius: 6;
                               -fx-background-radius: 6;
                               -fx-cursor: hand;
                               -fx-font-size: 12px;
                               -fx-effect: dropshadow(gaussian, rgba(70,190,98,0.3), 6, 0, 0, 2);"/>
            </HBox>

        </VBox>

    </VBox>
</VBox>