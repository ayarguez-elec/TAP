<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.AjouterPouchoirController"
      spacing="0"
      alignment="TOP_CENTER"
      style="-fx-background-color: #f0f2f5;"
      prefWidth="Infinity"
      prefHeight="Infinity">

    <!-- HEADER -->
    <VBox style="-fx-background-color: #ffffff;
                 -fx-padding: 10 25;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 8, 0, 0, 2);">

        <HBox alignment="CENTER_LEFT" spacing="12">
            <Button text="← Retour" onAction="#handleRetour"
                    style="-fx-background-color: rgba(255,255,255,0.15);
                           -fx-text-fill: #ffffff;
                           -fx-font-weight: bold;
                           -fx-padding: 5 14;
                           -fx-border-radius: 5;
                           -fx-background-radius: 5;
                           -fx-cursor: hand;
                           -fx-font-size: 11px;
                           -fx-border-color: rgba(255,255,255,0.15);
                           -fx-border-width: 1;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox alignment="CENTER_RIGHT">
                <Label text="Ajouter un pouchoir"
                       style="-fx-text-fill: #ffffff;
                              -fx-font-size: 16px;
                              -fx-font-weight: bold;
                              -fx-letter-spacing: 1px;"/>
                <Label text="Remplissez les informations ci-dessous"
                       style="-fx-text-fill: #6F8D94; -fx-font-size: 10px; -fx-font-weight: 300;"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- CORPS -->
    <VBox spacing="10" alignment="TOP_CENTER" style="-fx-padding: 18 25; -fx-background-color: #f0f2f5;">

        <!-- Carte formulaire -->
        <VBox spacing="10" style="-fx-background-color: #ffffff;
                                  -fx-border-radius: 8;
                                  -fx-background-radius: 8;
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, 0, 2);
                                  -fx-padding: 15 25 18 25;"
              maxWidth="650" prefWidth="650">

            <HBox alignment="CENTER_LEFT" spacing="6">
                <Rectangle width="2.5" height="16" fill="#3A98A5" arcWidth="2" arcHeight="2"/>
                <Label text="Informations du pouchoir"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #21262A;"/>
            </HBox>

            <Separator style="-fx-background-color: #e8eaee;"/>

            <GridPane hgap="12" vgap="8" alignment="CENTER" style="-fx-padding: 3 0 3 0;">

                <columnConstraints>
                    <ColumnConstraints prefWidth="115" minWidth="115" maxWidth="115" halignment="RIGHT"/>
                    <ColumnConstraints prefWidth="380" hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- Ligne 1 : Référence -->
                <Label text="Référence" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 11.5px;"
                       GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="refField" promptText="Ex: SI2234"
                           style="-fx-padding: 6 10; -fx-border-radius: 4; -fx-background-radius: 4;
                                  -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                  -fx-background-color: #fafbfc;"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <!-- Ligne 2 : Programme -->
                <Label text="Programme" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 11.5px;"
                       GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="programmeField" promptText="Ex: 109876542"
                           style="-fx-padding: 6 10; -fx-border-radius: 4; -fx-background-radius: 4;
                                  -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                  -fx-background-color: #fafbfc;"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <!-- Ligne 3 : Client -->
                <Label text="Client" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 11.5px;"
                       GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <HBox spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="2" GridPane.columnIndex="1">
                    <ComboBox fx:id="clientCombo" promptText="Sélectionner"
                              style="-fx-padding: 4 8; -fx-border-radius: 4; -fx-background-radius: 4;
                                     -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 11px;
                                     -fx-background-color: #fafbfc;"
                              prefWidth="200"/>
                    <Label text="Nouveau ?" style="-fx-text-fill: #3A98A5; -fx-font-size: 10px; -fx-cursor: hand; -fx-underline: true;"
                           onMouseClicked="#handleNewClient"/>
                </HBox>

                <!-- Ligne 4 : Produit -->
                <Label text="Produit" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 11.5px;"
                       GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <HBox spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="3" GridPane.columnIndex="1">
                    <ComboBox fx:id="produitCombo" promptText="Sélectionner"
                              style="-fx-padding: 4 8; -fx-border-radius: 4; -fx-background-radius: 4;
                                     -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 11px;
                                     -fx-background-color: #fafbfc;"
                              prefWidth="200"/>
                    <Label text="Nouveau ?" style="-fx-text-fill: #3A98A5; -fx-font-size: 10px; -fx-cursor: hand; -fx-underline: true;"
                           onMouseClicked="#handleNewProduit"/>
                </HBox>

                <!-- Ligne 5 : Quantité cartes -->
                <Label text="Quantité cartes" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 11.5px;"
                       GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="quantiteField" promptText="Ex: 100"
                           style="-fx-padding: 6 10; -fx-border-radius: 4; -fx-background-radius: 4;
                                  -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                  -fx-background-color: #fafbfc;"
                           GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <!-- Ligne 6 : Nbr cartes dans flan -->
                <Label text="Nbr cartes dans flan" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 11.5px;"
                       GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <TextField fx:id="nbFlanField" promptText="Ex: 10"
                           style="-fx-padding: 6 10; -fx-border-radius: 4; -fx-background-radius: 4;
                                  -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 12px;
                                  -fx-background-color: #fafbfc;"
                           GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                <!-- Ligne 7 : Racle -->
                <Label text="Racle" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 11.5px;"
                       GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <ComboBox fx:id="racleCombo"
                          style="-fx-padding: 4 8; -fx-border-radius: 4; -fx-background-radius: 4;
                                 -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 11px;
                                 -fx-background-color: #fafbfc;"
                          prefWidth="120"
                          GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                <!-- Ligne 8 : Face -->
                <Label text="Face" style="-fx-font-weight: bold; -fx-text-fill: #21262A; -fx-font-size: 11.5px;"
                       GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                <ComboBox fx:id="faceCombo"
                          style="-fx-padding: 4 8; -fx-border-radius: 4; -fx-background-radius: 4;
                                 -fx-border-color: #d0d5dd; -fx-border-width: 1; -fx-font-size: 11px;
                                 -fx-background-color: #fafbfc;"
                          prefWidth="90"
                          GridPane.rowIndex="7" GridPane.columnIndex="1"/>

            </GridPane>

            <!-- Boutons -->
            <HBox spacing="12" alignment="CENTER" style="-fx-padding: 8 0 0 0;">
                <Button text="Annuler" onAction="#handleAnnuler"
                        style="-fx-background-color: #e8eaee;
                               -fx-text-fill: #6F8D94;
                               -fx-font-weight: bold;
                               -fx-padding: 5 22;
                               -fx-border-radius: 4;
                               -fx-background-radius: 4;
                               -fx-cursor: hand;
                               -fx-font-size: 11px;"/>
                <Button text="✅ Valider" onAction="#handleValider"
                        style="-fx-background-color: #46BE62;
                               -fx-text-fill: #ffffff;
                               -fx-font-weight: bold;
                               -fx-padding: 5 22;
                               -fx-border-radius: 4;
                               -fx-background-radius: 4;
                               -fx-cursor: hand;
                               -fx-font-size: 11px;
                               -fx-effect: dropshadow(gaussian, rgba(70,190,98,0.25), 4, 0, 0, 2);"/>
            </HBox>

        </VBox>

    </VBox>
</VBox>